# Copy to ai_service/.env (git-ignored) for local runs outside Docker.
# In Docker these values come from docker-compose.yml (override them in a root .env file).

# --- rag_qa: shared secret with the Moodle plugin local_ai_qa (Site admin > Plugins > Local > AI Course Q&A)
RAG_API_KEY=smartlms-dev-key
# Where the index is stored (default: ai_service/vector_store/rag_qa, git-ignored)
# RAG_DATA_DIR=

# --- LLM: any OpenAI-compatible server (LM Studio, Ollama, vLLM, OpenAI, Gemini...)
# LLM_PROVIDER=auto            # auto | openai | extractive (no LLM: quote the best passages)
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=google/gemma-4-e4b
# LLM_API_KEY=
# For "thinking" models (Gemma 4, Qwen 3...): none = answer directly, much faster
LLM_REASONING_EFFORT=none

# --- Embeddings for semantic search (leave empty for keyword search only)
EMBED_MODEL=text-embedding-vietnamese_embedding_v2
# EMBED_BASE_URL=              # defaults to LLM_BASE_URL
EMBED_MIN_SCORE=0.45
